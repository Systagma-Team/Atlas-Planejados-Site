# ============================================================================
# Atlas Planejados — variáveis de ambiente
# Copie para .env (desenvolvimento) ou cadastre no painel da hospedagem (produção).
# NUNCA envie o .env real para o Git nem cole estes valores em conversas.
# ============================================================================

# --- Banco de dados (Postgres) ---------------------------------------------
# Desenvolvimento: rode "npm run db:local" (Postgres local, sem Docker) e use:
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/atlas"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/atlas"

# Produção com Supabase (Project Settings > Database > Connection string):
#   DATABASE_URL = "Transaction pooler" (porta 6543)  + parâmetros ?pgbouncer=true&connection_limit=5
#   DIRECT_URL   = conexão direta (porta 5432). Se sua rede não tiver IPv6, use o "Session pooler" (também porta 5432).
# DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# --- Fotos -----------------------------------------------------------------
# "local": grava em UPLOAD_DIR (desenvolvimento ou VPS com disco persistente)
# "supabase": grava no bucket do Supabase Storage (Netlify/serverless)
STORAGE_DRIVER="local"
UPLOAD_DIR="./data/uploads"

# Somente com STORAGE_DRIVER="supabase":
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<chave service_role — SECRETA, só no servidor>"
# SUPABASE_STORAGE_BUCKET="projetos"
# URL pública do bucket (bucket precisa ser Público). ATENÇÃO: é lida no BUILD; mudou? faça novo deploy.
# NEXT_PUBLIC_MEDIA_BASE_URL="https://<ref>.supabase.co/storage/v1/object/public/projetos"

# --- Aplicação -------------------------------------------------------------
# Chave que assina a sessão do administrador (mín. 32 caracteres). Gere uma nova para produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Endereço público do site (sitemap, Open Graph, canonical)
SITE_URL="http://localhost:3000"

# --- Primeiro administrador (usado só por "npm run db:seed" / "npm run admin:create") ---
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
