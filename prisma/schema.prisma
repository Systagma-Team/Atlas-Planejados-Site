// Atlas Planejados — modelo de dados
//
// Regras de integridade:
//  - Category -> Project usa onDelete: Restrict. O banco RECUSA apagar uma categoria que tenha projetos.
//    O fluxo normal é ocultar (isActive = false), nunca excluir.
//  - Project -> ProjectImage usa Cascade (apagar o projeto apaga suas fotos).
//  - Project.coverImageId usa SetNull (se a foto de capa for removida, o projeto cai na primeira foto).

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" = ambiente de execução da Netlify/AWS Lambda (o build roda em outra plataforma).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Postgres (Supabase em produção; Postgres local em desenvolvimento — veja "npm run db:local").
//  - DATABASE_URL: conexão usada pelo site (no Supabase: pooler, porta 6543, com ?pgbouncer=true)
//  - DIRECT_URL:   conexão direta usada só pelas migrações (no Supabase: porta 5432)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Administrador")
  passwordHash String
  // Incrementado ao trocar a senha; invalida sessões antigas.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String    @default("")
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@index([isActive, displayOrder])
}

model Project {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  // Resumo curto: aparece nos cards e na meta description.
  description  String         @default("")
  // Texto complementar da página do projeto (parágrafos separados por linha em branco).
  details      String         @default("")
  // Ano de realização (opcional).
  year         Int?
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImageId String?
  coverImage   ProjectImage?  @relation("ProjectCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  images       ProjectImage[] @relation("ProjectImages")
  featured     Boolean        @default(false)
  published    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([published, featured, createdAt])
}

model ProjectImage {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  // Pasta em UPLOAD_DIR onde ficam as versões otimizadas (uma por largura).
  fileKey      String    @unique
  alt          String    @default("")
  width        Int
  height       Int
  // Miniatura minúscula em base64, usada como placeholder enquanto a foto carrega.
  blurDataUrl  String    @default("")
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  coverOf      Project[] @relation("ProjectCover")

  @@index([projectId, displayOrder])
}

// Pedidos de orçamento enviados pelo formulário do site.
model Lead {
  id        String    @id @default(cuid())
  name      String
  phone     String    @default("")
  email     String    @default("")
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

// Contadores do limitador de tentativas (login, contato, health). Fica no banco porque em hospedagem
// serverless a memória não é compartilhada entre execuções.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Configurações editáveis pelo painel (contato, textos). Chave/valor.
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}
